# OpenClaude environment variables example.
# Copy to `.env` (or set inline in your shell) and edit as needed.
# `.env` is gitignored; never commit real passwords or tokens.

# ---- Network binding ----
# Default: 127.0.0.1 (loopback only). The launcher refuses to serve LAN
# traffic without authentication. To enable LAN mode, set this to 0.0.0.0
# AND provide a password via config.yaml (the launcher will auto-generate
# one on first LAN start and write its sha256 hash to config.yaml).
# OPENCLAUDE_HOST=127.0.0.1

# Gateway port. The launcher retries port+1 once on EADDRINUSE.
# OPENCLAUDE_PORT=21300

# ---- Connector selection ----
# Set to 1 to use the Mock connector (local demo only; never connects to
# real Claude Desktop). Leave unset to use the UnavailableConnector, which
# reports the truth: no verified Claude Desktop route is available yet.
# OPENCLAUDE_USE_MOCK_CONNECTOR=0

# ---- LAN access password ----
# Explicit LAN access password (plaintext). When set, the launcher hashes it
# (sha256) and writes the hash to config.yaml; the plaintext is never logged,
# put in a URL, or written to config. Use this in headless/automated setups
# where the one-time UI display of an auto-generated password is not possible.
# OPENCLAUDE_ACCESS_PASSWORD=

# ---- Claude Desktop probe (Windows) ----
# Override the Claude Desktop install root the scanner checks first.
# Primary variable:
# OPENCLAUDE_CLAUDE_PATH=
# Legacy alias (still supported):
# OPENCLAUDE_CLAUDE_INSTALL_PATH=
# Override the WindowsApps directory scanned for `Claude_*` AppX installs
# (defaults to %PROGRAMFILES%\WindowsApps):
# OPENCLAUDE_WINDOWS_APPS_DIR=

# Allow the on-host probe to actually evaluate routes (default off). When
# off, the overall connector status is capped at unavailable even if an
# install is found, because the route protocol has not been verified.
# OPENCLAUDE_PROBE_ON_HOST=0

# ---- Runtime directories ----
# Override where config.yaml, logs, and reports live. Defaults to
# <userData>/runtime on the user profile, or .data/runtime in dev.
# OPENCLAUDE_RUNTIME_DIR=
# OPENCLAUDE_LOG_DIR=
# OPENCLAUDE_REPORTS_DIR=
# OPENCLAUDE_CONFIG_PATH=
# OPENCLAUDE_WEB_SHELL_DIR=

# ---- Auth token TTL ----
# Lifetime of in-memory access tokens issued after login (ms). Default 12h.
# Tokens are kept in memory only and are invalidated on gateway restart.
# OPENCLAUDE_AUTH_TOKEN_TTL_MS=43200000

# ---- Request limits ----
# Max bytes for non-login request bodies (default 2 MiB).
# OPENCLAUDE_MAX_REQUEST_BODY_BYTES=2097152

# ---- Launcher integration ----
# Shared secret for launcher-internal calls; leave empty in normal use.
# OPENCLAUDE_LAUNCHER_TOKEN=

# ---- Diagnostics ----
# Verbose diagnostic logging.
# OPENCLAUDE_DEBUG=0
# OPENCLAUDE_SLOW_LOG_MS=750

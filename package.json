{
  "name": "openclaude",
  "version": "0.2.0",
  "description": "A LAN companion for controlling Claude Desktop from a phone.",
  "private": true,
  "type": "module",
  "main": "dist/launcher/index.js",
  "scripts": {
    "build": "tsc -b",
    "build:main": "tsc -p tsconfig.main.json",
    "dev": "pnpm run build && electron .",
    "dev:watch": "tsc -p tsconfig.main.json --watch",
    "start": "electron .",
    "pretest": "pnpm run build",
    "test": "node --test test/*.test.mjs",
    "lint": "tsc --noEmit -p tsconfig.main.json",
    "sync:version": "node scripts/sync-version.mjs",
    "probe:claude": "node scripts/probe-claude-desktop.mjs",
    "pack:win": "pnpm run build && electron-builder --win"
  },
  "dependencies": {
    "@electron/asar": "^3.2.8",
    "resedit": "^2.0.3",
    "ws": "^8.18.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "electron": "42.0.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "dev.openclaude.app",
    "productName": "OpenClaude",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "web-shell/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}

{
  "compilerOptions": {
    "composite": true,
    "outDir": "dist/renderer",
    "rootDir": "src/renderer",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src/renderer/**/*.tsx", "src/renderer/**/*.ts"]
}
